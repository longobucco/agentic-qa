# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
logs
*.log

# scripts/*.out: raw stdout dumps from one-off batch drivers -- redundant with the matching
# *.log (concise progress) and with results/ (the authoritative eval.json/result.json data);
# mostly evaluator debug spam, not a useful artifact on its own. Scoped to scripts/ only.
scripts/*.out
npm-debug.log*

# Playwright MCP scratch output (console logs, page accessibility-tree snapshots) -- unrelated
# to any benchmark, swept into results commits via broad `git add` since 2026-08-13 (first
# commit: 89e0cbf on os-world). Untracked 2026-08-23.
.playwright-mcp/
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

