# Thesis research notes -- never committed, local only
benchmarks/osworld/docs/
benchmarks/osuniverse/data/osuniverse_tasks.jsonl

# OSWorld results. Only new-infrastructure campaign trees (system names ending in `_official`,
# e.g. `agent_computer_sonnet5_effortmax_official_kvm`) may be tracked, and only on the model
# branches. Phase 1 results (Daytona, legacy harness), probes and campaign logs stay local:
# they were purged from history on 2026-09-24 and are archived outside the repo. The frozen
# Phase 1 code lives under the tag `phase1-daytona-frozen`.
benchmarks/osworld/results/*
!benchmarks/osworld/results/*_official*/

# Inside a tracked tree, keep only what scoring, resume and analysis read. Raw artifacts
# (eval_artifacts/, office files, screenshots other than final.png, mcp_state.json) and the
# full transcript conversation.jsonl (several MB per run) are written locally, never tracked.
# An allowlist, not an extension blocklist, so a new artifact type cannot bloat the repo.
benchmarks/osworld/results/*/*/run_*/*
!benchmarks/osworld/results/*/*/run_*/result.json
!benchmarks/osworld/results/*/*/run_*/eval.json
!benchmarks/osworld/results/*/*/run_*/infra_error.json
!benchmarks/osworld/results/*/*/run_*/agent_output.txt
!benchmarks/osworld/results/*/*/run_*/final.png

# Open-book fixtures (Phase 1, 874 MB): local only.
benchmarks/osworld/openbook_fixtures/

# fetched by data/download_evaluators.py at the pinned upstream commit -- not source
benchmarks/osworld/data/evaluators/
benchmarks/osworld/data/controllers/
.worktrees/

# Project documentation (thesis material) stays local: never committed or pushed.
docs/
